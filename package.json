{
    "name": "easy-communicator",
    "version": "1.2.0",
    "description": "A communication helper library for JavaScript.",
    "keywords": [
        "javascript",
        "communication",
        "icp"
    ],
    "license": "LGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "https://github.com/henrikszucs/easy-communicator"
    },
    "bugs": "https://github.com/henrikszucs/easy-communicator/issues",
    "maintainers": [
        {
            "name": "Henrik Szucs",
            "email": "henrikszucs6@gmail.com"
        }
    ],
    "scripts": {
        "build": "node dev/build.js",
        "dev-server": "node dev/dev-server.js",
        "test": "node --test \"tests/**/*.test.js\"",
        "prepublishOnly": "npm run build && npm test"
    },
    "type": "module",
    "main": "./dist/communicator.cjs",
    "module": "./dist/communicator.js",
    "exports": {
        ".": {
            "import": "./dist/communicator.js",
            "require": "./dist/communicator.cjs"
        },
        "./min": "./dist/communicator.min.js",
        "./iife": "./dist/communicator.iife.min.js",
        "./src": "./src/communicator.js",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src"
    ],
    "devDependencies": {
        "easy-mime": "github:henrikszucs/easy-mime#v1.1.0",
        "esbuild": "^0.28.2"
    }
}
